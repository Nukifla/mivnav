.venv/
__pycache__/
*.egg-info/
.pytest_cache/
# The ingest output / cache dir at backend/data — anchored so it does not also
# ignore source packages named data/ (e.g. mivnav/data, the M-DATA layer).
# `/data/*` (not `/data/`) so a subpath below can be re-included — git cannot
# re-include anything under a directory that is itself excluded.
/data/*
# ...except the committed POI test fixture: a tiny (~4 KB) pre-baked POI
# PMTiles the poi feature module is proved against (backend/tests/test_poi.py),
# and the default poi.dir. Unlike the generated chart fixture it is checked in.
!/data/poi
!/data/poi/pois.pmtiles
# ...and the committed freenauticalchart.net chart fixtures: two real
# published cells (see data/fnc/SOURCE.txt for both) — DE6OSTIM.S57
# (38 KB, CC0), the only chart fixture in the tree that carries sectored
# lights, and DE6OSBRH.S57 (34 KB, CC0), the only one that charts a real
# fairway (NAVLNE/RECTRC) — mivnav's own Portal::touches_fairway/
# TopologyWeights have no other real (non-synthetic) fixture to prove
# themselves against. Listed file by file so a downloaded fnc-de.zip
# (63 MB) dropped in the same directory stays ignored.
!/data/fnc
/data/fnc/*
!/data/fnc/DE6OSTIM.S57
!/data/fnc/DE6OSBRH.S57
!/data/fnc/SOURCE.txt
# ...and the committed DWD ICON-EU GRIB2 fixtures (~2.3 MB total, DWD open
# data — see data/grib/SOURCE.txt): test_gribstore.py/test_grib_render.py's
# real-decode fixtures (jt mzyvvmux's GRIB bake). No GRIB encoder was
# available to hand-craft something smaller — see that SOURCE.txt for why.
!/data/grib
/data/grib/*
!/data/grib/icon-eu_europe_regular-lat-lon_single-level_2026072600_000_U_10M.grib2
!/data/grib/icon-eu_europe_regular-lat-lon_single-level_2026072600_000_V_10M.grib2
!/data/grib/SOURCE.txt
